# Local development only. Production infrastructure and credentials are owner-owned.
JAZZ_MASTER_POSTGRES_PORT=5432
DATABASE_URL=postgresql://jazz_master:jazz_master@127.0.0.1:5432/jazz_master
# Web runtime Hyperdrive override (takes precedence over DATABASE_URL).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://jazz_master:jazz_master@127.0.0.1:5432/jazz_master
