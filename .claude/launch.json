{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "codebase",
        "storybook"
      ],
      "port": 6006
    },
    {
      "name": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://jazz_master:jazz_master@127.0.0.1:55432/jazz_master",
        "DATABASE_URL=postgresql://jazz_master:jazz_master@127.0.0.1:55432/jazz_master",
        "PLAYWRIGHT_TEST_AUTH=1",
        "PUBLIC_PLAYWRIGHT_TEST_AUTH=1",
        "bun",
        "run",
        "--cwd",
        "codebase",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "storybook-only",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd codebase/apps/web && exec bunx storybook dev -p 6006 --no-open"
      ],
      "port": 6006
    },
    {
      "name": "storybook-second",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd codebase/apps/web && exec bunx storybook dev -p 6007 --no-open"
      ],
      "port": 6007
    },
    {
      "name": "web-clerk",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://jazz_master:jazz_master@127.0.0.1:55432/jazz_master",
        "DATABASE_URL=postgresql://jazz_master:jazz_master@127.0.0.1:55432/jazz_master",
        "bun",
        "run",
        "--cwd",
        "codebase",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://jazz_master:jazz_master@127.0.0.1:55432/jazz_master",
        "DATABASE_URL=postgresql://jazz_master:jazz_master@127.0.0.1:55432/jazz_master",
        "bun",
        "run",
        "--cwd",
        "codebase",
        "preview",
        "--",
        "--port",
        "4322"
      ],
      "port": 4322
    }
  ]
}
