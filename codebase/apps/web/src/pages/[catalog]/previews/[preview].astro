---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PublicHeader from '../../../components/public/PublicHeader.astro'
import PublicFooter from '../../../components/public/PublicFooter.astro'

export const prerender = true

// Static previews of the public Astro components, for the Storybook catalog.
// The landing page and the auth screens are React components with stories of their own.
export function getStaticPaths() {
  return ['header', 'footer'].map((preview) => ({ params: { catalog: '_storybook', preview } }))
}
const { preview } = Astro.params
const sections = { header: PublicHeader, footer: PublicFooter }
const Section = sections[preview as keyof typeof sections]
---

<BaseLayout noindex><div class="min-h-screen bg-canvas text-fg">{Section && <Section />}</div></BaseLayout>
