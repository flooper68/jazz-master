---
import WoodshedShell from './WoodshedShell.astro'

interface Props {
  mode: 'sign-in' | 'sign-up'
  theme?: 'light' | 'dark'
}

const { mode, theme } = Astro.props
const signUp = mode === 'sign-up'
---

<WoodshedShell theme={theme} minimal>
  <main class="mx-auto w-full max-w-7xl flex-1 px-5 py-6 sm:px-6 lg:px-8">
    <section
      class="flex min-h-[calc(100vh-190px)] items-center justify-center rounded-2xl border border-line bg-panel px-6 py-16"
      aria-label="Authentication form"
    >
      <div class="w-full">
        <slot />
        {!signUp && (
          <p class="mx-auto mt-6 max-w-md text-center text-sm text-muted">
            Forgot your password? Start the reset from the form above — every step stays on this page.
          </p>
        )}
      </div>
    </section>
  </main>
</WoodshedShell>
