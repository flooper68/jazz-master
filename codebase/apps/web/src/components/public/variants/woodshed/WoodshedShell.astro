---
/**
 * "Woodshed" — the working code name and the chosen public-page direction:
 * off-white, bold tight grotesk headlines, black pill CTAs, floating pastel
 * shapes and tilted colour cards (Podia-inspired). Tokens and fonts are the
 * app-wide ones from src/index.css; `theme` pins a scheme for prerendered
 * previews, otherwise the system scheme decides.
 */
interface Props {
  theme?: 'light' | 'dark'
  /** Minimal chrome for auth pages: wordmark plus sign-up / log-in links only. */
  minimal?: boolean
}

const { theme, minimal = false } = Astro.props
---

<div class="flex min-h-screen flex-col bg-canvas text-fg" data-theme={theme}>
  <header class:list={['relative z-10', minimal && 'border-b border-line bg-panel']}>
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-5 sm:px-6 lg:px-8">
      <a href="/" class="font-display text-[1.9rem] leading-none font-extrabold tracking-tight">woodshed</a>
      {minimal ? (
        <nav aria-label="Account" class="flex items-center gap-6 text-sm text-fg-2">
          <a href="/sign-up" class="hover:text-fg">Sign up</a>
          <a href="/sign-in" class="hover:text-fg">Log in</a>
        </nav>
      ) : (
        <>
          <nav aria-label="Public navigation" class="hidden items-center gap-8 text-[15px] text-fg-2 md:flex">
            <a href="/#why" class="hover:text-fg">Why</a>
            <a href="/#practise" class="hover:text-fg">What you practise</a>
            <a href="/#day" class="hover:text-fg">A day</a>
          </nav>
          <div class="flex items-center gap-3">
            <a href="/sign-in" class="px-3 py-2 text-[15px] text-fg-2 hover:text-fg">Login</a>
            <a href="/sign-up" class="rounded-xl bg-cta px-5 py-3 text-[15px] font-medium text-cta-fg hover:bg-cta-hover">
              Sign up free
            </a>
          </div>
        </>
      )}
    </div>
  </header>

  <slot />

  <footer class:list={['mt-auto border-t border-line text-muted', minimal && 'bg-panel']}>
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
      <div>
        <p class="font-display text-xl font-extrabold tracking-tight text-fg">woodshed</p>
        <p class="mt-1 text-sm">Smart, personal guitar practice — a few easy minutes a day.</p>
      </div>
      <nav aria-label="Footer navigation" class="flex flex-wrap gap-6 text-sm">
        <a href="/sign-up" class="text-fg">Sign up free</a>
        <a href="/sign-in" class="hover:text-fg">Log in</a>
        <a href="/app" class="hover:text-fg">Open app</a>
      </nav>
    </div>
  </footer>
</div>
