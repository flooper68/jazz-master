---
/**
 * Inert stand-in for the Clerk form inside design previews, styled with the
 * app-wide tokens so it follows whichever theme wraps it.
 */
interface Props {
  mode: 'sign-in' | 'sign-up'
  brand?: string
}

const { mode, brand = 'Woodshed' } = Astro.props
const signUp = mode === 'sign-up'
const input = 'mt-2 block w-full rounded-lg border border-line-strong bg-field px-3 py-2.5 text-sm text-fg'
---

<div class="mx-auto w-full max-w-md space-y-4 text-fg">
  <div class="text-center">
    <h2 class="text-2xl font-semibold">{signUp ? `Sign up for ${brand}` : `Log in to ${brand}`}</h2>
    <p class="mt-2 text-muted">{signUp ? 'Start your free 30-day trial today.' : 'Welcome back — today’s rep is waiting.'}</p>
    <p class="mt-1 text-xs text-muted">Storybook preview. The live app renders the Clerk form here.</p>
  </div>
  {signUp && (
    <label class="block text-sm font-medium">
      Name
      <input type="text" disabled placeholder="e.g. Wes Montgomery" class={input} />
    </label>
  )}
  <label class="block text-sm font-medium">
    Email
    <input type="email" disabled placeholder="e.g. wes@example.com" class={input} />
  </label>
  <label class="block text-sm font-medium">
    Password
    <input type="password" disabled placeholder="••••••••" class={input} />
    {signUp && <span class="mt-1.5 block text-xs font-normal text-muted">Minimum 6 characters.</span>}
  </label>
  <button type="button" disabled class="w-full rounded-lg bg-cta px-4 py-3 text-sm font-semibold text-cta-fg">
    {signUp ? 'Get started' : 'Log in'}
  </button>
  <p class="text-center text-sm text-muted">
    {signUp ? 'Already have an account? ' : 'New here? '}
    <span class="text-fg underline">{signUp ? 'Log in' : 'Sign up free'}</span>.
    {!signUp && <span> · <span class="text-fg underline">Forgot password?</span></span>}
  </p>
</div>
