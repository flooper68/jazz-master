---
import { Lockup } from '../Brand'
import { ButtonLink } from '../ui/Primitives'
---

<header class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-5 py-5 sm:px-8">
  <a href="/" aria-label="Count-in, home" class="flex items-center gap-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
    <Lockup />
    <span class="rounded-sm border border-line-strong px-1.5 py-1 font-mono text-[10px] leading-none tracking-[0.14em] text-muted uppercase">Beta</span>
  </a>

  <nav aria-label="Account" class="flex items-center gap-2">
    <ButtonLink href="/sign-in" variant="quiet" size="lg">Sign in</ButtonLink>
    <ButtonLink href="/#beta" size="lg">Join the beta</ButtonLink>
  </nav>
</header>
