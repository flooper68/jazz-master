---
import { Mark } from '../../Brand'

interface Props {
  eyebrow: string
  heading: string
  body: string
}

const { eyebrow, heading, body } = Astro.props
---

<main class="mx-auto grid w-full max-w-6xl flex-1 items-center gap-10 px-5 py-12 sm:px-8 md:grid-cols-[0.9fr_1.1fr]">
  <section class="flex max-w-xl flex-col gap-6">
    <p class="font-mono text-xs tracking-[0.14em] text-accent-text uppercase">{eyebrow}</p>
    <h1 class="font-display text-[clamp(2.5rem,5.5vw,4.25rem)] leading-[0.95] font-semibold tracking-[-0.04em] text-balance">
      {heading}
    </h1>
    <p class="max-w-[46ch] text-lg leading-relaxed text-fg-2">{body}</p>
    <Mark className="mt-4 h-10 w-[6.04rem] text-fg" />
  </section>

  <section class="auth-form-shell flex min-w-0 justify-center overflow-hidden rounded-xl border border-line bg-panel px-0 py-6 sm:px-8" aria-label="Authentication form">
    <div class="w-full min-w-0">
      <slot />
    </div>
  </section>
</main>

<style>
  .auth-form-shell :global(.cl-rootBox),
  .auth-form-shell :global(.cl-cardBox) {
    max-width: 100%;
    width: 100%;
  }
</style>
