---
import { SignUp } from '@clerk/astro/components'
import { clerkAuthRoutes } from '../../../server/auth/clerkRoutes'
import PublicShell from '../PublicShell.astro'
import AuthPage from './AuthPage.astro'
---

<PublicShell title="Create your account — Count-in" noindex>
  <AuthPage
    eyebrow="Practice smart"
    heading="Describe your goal. Then just play."
    body="Create an account so Count-in can keep your plan, your history and your next step, wherever you pick up your instrument."
  >
    <SignUp
      routing="path"
      path={clerkAuthRoutes.signUp}
      signInUrl={clerkAuthRoutes.signIn}
      fallbackRedirectUrl={clerkAuthRoutes.appFallback}
      appearance={{
        variables: {
          colorPrimary: '#18181b',
        },
      }}
    />
  </AuthPage>
</PublicShell>
