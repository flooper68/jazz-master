// Minimal Worker config: the @astrojs/cloudflare adapter fills in main/assets/
// bindings itself, but nodejs_compat must be set here — Astro's runtime code
// executes inside workerd (even in dev) and needs the Node globals.
// TASK-024 extends this for the actual deployment.
{
  // Must match the deployed Worker that Cloudflare Workers Builds publishes to
  // and that serves jazz-master.premysl-ciompa.workers.dev. It read
  // "jazz-master-web" until ISSUE-011, so every repo-local wrangler command
  // targeted a Worker that does not exist.
  "name": "jazz-master",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "vars": {
    "PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_b3JnYW5pYy1vc3RyaWNoLTM0LmNsZXJrLmFjY291bnRzLmRldiQ"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "550beedd38384ddcac7dc1c044eede5d",
      // Local runtime initialization also runs during Astro prerendering.
      // Override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "localConnectionString": "postgresql://jazz_master:jazz_master@127.0.0.1:5432/jazz_master"
    }
  ]
}
